{
  "name": "cmdx-terminal-launcher",
  "version": "0.1.0",
  "description": "Offline-first cross-platform terminal command launcher",
  "type": "module",
  "bin": { "cmdx": "dist/src/cli.js" },
  "files": ["dist", "data", "shell", "README.md", "LICENSE"],
  "dependencies": {
    "commander": "^14.0.0",
    "ink": "^6.3.0",
    "open": "^10.2.0",
    "react": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "eslint": "^9.35.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json && node scripts/add-shebang.mjs",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "engines": { "node": ">=20" },
  "license": "MIT"
}
