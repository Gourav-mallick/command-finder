{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "jsx": "react-jsx", "outDir": "dist", "rootDir": ".",
    "resolveJsonModule": true, "forceConsistentCasingInFileNames": true,
    "declaration": true, "sourceMap": true, "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "data/**/*.json", "tests/**/*.ts", "tests/**/*.tsx"]
}
