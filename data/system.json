      "category": "System administration",
      "tags": [
        "archive",
        "compress",
        "zip"
      ],
      "examples": [
        "zip -r source.zip src/"
      ],
      "platforms": [
        "linux",
        "macos"
      ],
      "risk": "low"
    },
    {
      "id": "linux-unzip",
      "name": "Extract a zip archive",
      "command": "unzip <archive.zip>",
