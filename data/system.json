{
  "commands": [
    {
      "id": "linux-tar-create",
      "name": "Create a tar archive",
      "command": "tar -czf archive.tar.gz <directory>",
      "description": "Create a gzip-compressed tar archive of a directory.",
      "category": "System administration",
      "tags": [
        "archive",
        "compress",
        "tar"
      ],
      "examples": [
        "tar -czf source.tar.gz src/"
      ],
      "platforms": [
        "linux",
        "macos"
      ],
      "risk": "low"
    },
    {
      "id": "linux-tar-extract",
      "name": "Extract a tar archive",
      "command": "tar -xzf <archive.tar.gz>",
      "description": "Extract a gzip-compressed tar archive into the current directory.",
      "category": "System administration",
      "tags": [
        "archive",
        "extract",
        "tar"
      ],
      "examples": [
        "tar -xzf backup.tar.gz -C /tmp/restore"
      ],
      "platforms": [
        "linux",
        "macos"
      ],
      "risk": "medium"
    },
    {
      "id": "linux-zip",
      "name": "Create a zip archive",
      "command": "zip -r archive.zip <directory>",
