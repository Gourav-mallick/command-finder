{
  "commands": [
    {
      "id": "sqlite-open",
      "name": "Open a SQLite database",
      "command": "sqlite3 <database.db>",
      "description": "Open or create a SQLite database in the interactive sqlite3 shell.",
      "category": "SQLite",
      "tags": [
        "sqlite",
        "database",
        "shell"
      ],
      "examples": [],
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "risk": "medium"
    },
    {
      "id": "sqlite-tables",
      "name": "List SQLite tables",
      "command": "sqlite3 <database.db> \".tables\"",
      "description": "List tables in a SQLite database, including a Room database file.",
      "category": "SQLite",
      "tags": [
        "sqlite",
        "room",
        "tables"
      ],
      "examples": [],
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "risk": "low"
    },
    {
      "id": "sqlite-schema",
      "name": "Show SQLite schema",
      "command": "sqlite3 <database.db> \".schema\"",
      "description": "Print table and index creation statements from a SQLite database.",
      "category": "SQLite",
      "tags": [
        "sqlite",
        "room",
        "schema"
      ],
      "examples": [],
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "risk": "low"
    },
    {
      "id": "sqlite-query",
      "name": "Run a read-only SQLite query",
      "command": "sqlite3 -readonly <database.db> \"SELECT name FROM sqlite_master WHERE type='table';\"",
      "description": "Run a query in read-only mode to inspect a SQLite database.",
      "category": "SQLite",
      "tags": [
        "sqlite",
        "query",
        "room"
      ],
      "examples": [],
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "risk": "low"
    },
    {
      "id": "sqlite-backup",
      "name": "Back up a SQLite database",
      "command": "sqlite3 <database.db> \".backup <backup.db>\"",
      "description": "Create a consistent SQLite database backup using the sqlite shell.",
      "category": "SQLite",
      "tags": [
        "sqlite",
        "backup",
        "database"
      ],
      "examples": [],
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "risk": "medium"
    },
    {
      "id": "sqlite-integrity",
      "name": "Check SQLite database integrity",
      "command": "sqlite3 <database.db> \"PRAGMA integrity_check;\"",
      "description": "Run SQLite’s integrity check against a database file.",
      "category": "SQLite",
      "tags": [
        "sqlite",
        "integrity",
        "check"
      ],
      "examples": [],
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "risk": "low"
    },
    {
      "id": "sqlite-dump",
      "name": "Dump SQLite database to SQL",
      "command": "sqlite3 <database.db> \".dump\" > <dump.sql>",
      "description": "Export the entire database schema and records as executable SQL statements.",
      "category": "SQLite",
      "tags": [
        "sqlite",
        "dump",
        "export",
        "backup"
      ],
      "examples": [],
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "risk": "medium"
    },
    {
      "id": "sqlite-table-output",
      "name": "Query SQLite with column headers",
      "command": "sqlite3 -header -column <database.db> \"<query>\"",
      "description": "Run a SQL query and print readable columnar results with column headers.",
      "category": "SQLite",
      "tags": [
        "sqlite",
        "query",
        "format",
        "table"
      ],
      "examples": [
        "sqlite3 -header -column app.db \"SELECT * FROM users LIMIT 10;\""
      ],
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "risk": "low"
    }
  ]
}
